# --- Python runtime / bytecode (generated by the interpreter) ---
__pycache__/
*.py[cod]

# --- Virtual environment (recreated from pyproject.toml / uv.lock) ---
.venv/

# --- Packaging / test tool caches (regenerated on build & test runs) ---
build/
dist/
*.egg-info/
.pytest_cache/

# --- IDE local state (JetBrains PyCharm) ---
.idea/

# --- Local commit-message draft (never committed) ---
COMMIT.md

# --- OS junk ---
.DS_Store
Thumbs.db
